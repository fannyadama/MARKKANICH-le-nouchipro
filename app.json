{
  "expo": {
    "name": "Markkanich Le NouchiPro",
    "slug": "markkanich-nouchipro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markkanich.nouchipro",
      "buildNumber": "1",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Markkanich utilise la reconnaissance vocale pour vous permettre de dicter des phrases en nouchi.",
        "NSMicrophoneUsageDescription": "Markkanich a besoin de l'accès au micro pour la prononciation et la recherche vocale.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.markkanich.nouchipro",
      "versionCode": 1,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#09090b"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./public/favicon.ico",
      "themeColor": "#f59e0b",
      "backgroundColor": "#09090b"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          },
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "markkanich-nouchipro-production"
      }
    }
  }
}
